.DS_Store

# El repo es público: no se suben libros ni papers con derechos de autor.
# Las lecturas con copyright se distribuyen por Aula, no por aquí.
lecturas/*.pdf
lecturas/*.epub
lecturas/*.mobi

__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
.env
.uv/
uv.lock
*.egg-info/
.jupyter/
.ruff_cache/

# Los scripts que arman las slides, las figuras y los notebooks son material de
# trabajo de la profesora y no se publican. Los .pptx, .pdf e .ipynb resultantes si.
presentaciones/build_*.py
presentaciones/estilo.py
presentaciones/figuras_*.py
presentaciones/figuras/

# Las evaluaciones no aplicadas y sus pautas no se publican: el repo es publico.
# Despues de aplicar una evaluacion se puede publicar con: git add -f <archivo>
evaluaciones/controles/*
evaluaciones/certamenes/*
evaluaciones/rubricas/*
!evaluaciones/controles/.gitkeep
!evaluaciones/certamenes/.gitkeep
!evaluaciones/rubricas/.gitkeep
